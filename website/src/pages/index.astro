---
import "@fontsource/cabin/latin-400.css";
import "@fontsource/cabin/latin-600.css";
import "@fontsource/cabin/latin-700.css";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const iconUrl = `${base}littlepickle-app-icon.png`;
const pageUrl = new URL("/", Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="LittlePickle is the easiest pickleball queue for your local courts" />
    <meta name="theme-color" content="#F6F2E8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="LittlePickle" />
    <meta property="og:description" content="The easiest pickleball queue for your local courts" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${pageUrl}littlepickle-app-icon.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="LittlePickle" />
    <meta name="twitter:description" content="The easiest pickleball queue for your local courts" />
    <meta name="twitter:image" content={`${pageUrl}littlepickle-app-icon.png`} />
    <link rel="icon" type="image/png" href={iconUrl} />
    <title>LittlePickle — Your local court, sorted.</title>
  </head>
  <body>
    <main class="site-shell">
      <section class="basket" aria-labelledby="littlepickle-title">
        <div class="ball-field" aria-hidden="true"></div>

        <article class="hero-panel">
          <div class="brand-lockup">
            <img class="app-icon" src={iconUrl} alt="" width="1254" height="1254" />
            <h1 id="littlepickle-title">LittlePickle</h1>
          </div>

          <p class="tagline">The easiest pickleball queue for your local courts</p>

          <div class="store-actions" aria-label="LittlePickle app availability">
            <button class="store-button" type="button" aria-label="App Store, coming soon" disabled>
              <span class="store-button__copy">
                <span class="store-button__eyebrow">Download on the</span>
                <span class="store-button__name">App Store</span>
              </span>
              <span class="store-button__status">Coming soon</span>
            </button>

            <button class="store-button" type="button" aria-label="Google Play, coming soon" disabled>
              <span class="store-button__copy">
                <span class="store-button__eyebrow">Get it on</span>
                <span class="store-button__name">Google Play</span>
              </span>
              <span class="store-button__status">Coming soon</span>
            </button>
          </div>

        </article>

        <nav class="page-legal-links" aria-label="Legal and support">
          <a href={`${base}privacy/`}>Privacy</a>
          <a href={`${base}support/`}>Support</a>
          <a href={`${base}terms/`}>Terms</a>
        </nav>
      </section>
    </main>

    <script>
      const field = document.querySelector<HTMLElement>(".ball-field");
      const ballColors = ["chalk", "royal", "chalk", "leaf", "royal", "chalk", "royal"] as const;
      const ballRotations = [-28, 18, -12, 30, -22, 10, 24, -18];
      const collisionGap = 4;
      const minimumDiameter = 84;
      const maximumDiameter = 176;
      const targetColumns = 12;
      const targetRows = 7;
      const packedBalls: HTMLElement[] = [];
      let packedWidth = 0;
      let packedHeight = 0;
      let hasPacked = false;

      const createBall = (index: number) => {
        const ball = document.createElement("div");
        const rotation = ballRotations[index % ballRotations.length];
        const holeCount = index % 3 === 0 ? 6 : 5;

        ball.className = `ball ball--${ballColors[(index * 2) % ballColors.length]}`;
        ball.style.setProperty("--ball-rotation", `${rotation}deg`);
        ball.style.setProperty("--ball-start-rotation", `${rotation + (index % 2 === 0 ? -108 : 112)}deg`);
        ball.style.setProperty("--ball-duration", `${0.9 + (index % 5) * 0.045}s`);

        for (let holeIndex = 1; holeIndex <= holeCount; holeIndex += 1) {
          const hole = document.createElement("span");
          hole.className = `ball__hole ball__hole--${holeIndex}`;
          ball.append(hole);
        }

        return ball;
      };

      const packBalls = () => {
        if (!field) {
          return;
        }

        const { clientWidth: width, clientHeight: height } = field;

        if (width === packedWidth && height === packedHeight) {
          return;
        }

        if (hasPacked) {
          field.dataset.settled = "true";
        }

        packedWidth = width;
        packedHeight = height;

        const diameter = Math.max(
          minimumDiameter,
          Math.min(width / targetColumns, height / targetRows, maximumDiameter)
        );
        const horizontalStep = diameter + collisionGap;
        const verticalStep = horizontalStep * Math.sqrt(3) / 2;
        const columns = Math.ceil(width / horizontalStep) + 2;
        const rows = Math.ceil(height / verticalStep) + 2;
        const ballCount = columns * rows;

        while (packedBalls.length < ballCount) {
          const ball = createBall(packedBalls.length);
          packedBalls.push(ball);
          field.append(ball);
        }

        packedBalls.forEach((ball, index) => {
          if (index >= ballCount) {
            ball.hidden = true;
            return;
          }

          const row = Math.floor(index / columns);
          const column = index % columns;
          const left = column * horizontalStep + (row % 2 === 0 ? 0 : horizontalStep / 2) - diameter / 2;
          const top = row * verticalStep - diameter / 2;
          const fillRow = rows - row - 1;
          const delay = fillRow * 0.065 + (column % 4) * 0.018;

          ball.hidden = false;
          ball.style.setProperty("--ball-size", `${diameter}px`);
          ball.style.setProperty("--ball-left", `${left}px`);
          ball.style.setProperty("--ball-top", `${top}px`);
          ball.style.setProperty("--ball-delay", `${delay}s`);
        });

        field.dataset.packed = "true";
        hasPacked = true;
      };

      packBalls();

      if (field) {
        new ResizeObserver(packBalls).observe(field);
      }
    </script>
  </body>
</html>
