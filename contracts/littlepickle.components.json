    {
      "id": "component.action.qr",
      "name": "QR action",
      "version": "1.0.0",
      "status": "stable",
      "purpose": "Begin league entry by opening the QR scanning flow.",
      "props": {
        "label": {
          "type": "string",
          "required": false,
          "default": "Scan league QR"
        },
        "supportingText": {
          "type": "string",
          "required": false,
          "default": null
        },
        "disabled": {
          "type": "boolean",
          "required": false,
          "default": false
        },
        "errorMessage": {
          "type": "string",
          "required": false,
          "default": null
        }
      },
      "states": [
        "default",
        "pressed",
        "focused",
        "disabled",
        "error"
      ],
      "accessibility": {
        "role": "button",
        "nameRule": "Accessible name describes scanning a league QR code.",
        "keyboard": [
          "Enter",
          "Space"
        ],
        "focusBehavior": "Visible 2px Club Royal ring with 2px offset.",
        "minimumTarget": "48x48"
      },
      "tokens": [
        "color.surface.card",
        "color.border.control",
        "color.action.primary",
        "color.surface.info",
        "radius.control",
        "size.qr-action.minimum-height",
        "size.icon.primary"
      ],
      "constraints": {
        "fullWidth": true,
        "minimumHeight": 160,
        "padding": 20,
        "forbiddenCompositions": [
          "Nested inside a generic card",
          "Icon-only label",
          "Automatic camera permission before activation"
        ]
      },
      "events": {
        "scanRequested": {
          "payload": {
            "source": "home"
          }
        }
      },
      "provenance": {
        "source": {
          "designSystem": "LittlePickle v1.0",
          "wireframes": [
            "Home Wireframe",
            "Play Wireframe"
          ]
        },
        "updatedAt": "2026-06-19",
        "generatedFrom": "Approved design workshop decisions"
      }
    },
